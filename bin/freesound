#!/usr/bin/env bash
# freesound — operate CLI for freesound.lab980.com (Freesound Boards).
#
# A proxied app site: nginx fronts a pm2-managed Node process on
# 127.0.0.1:8074. Bring-up is `provision-site` (see lab980's CLAUDE.md);
# this script owns everything after that:
#
#   freesound deploy    git pull -> npm ci -> build -> pm2 start/restart -> probe -> save
#   freesound restart   pm2 restart + probe, no code change
#   freesound logs      tail the pm2 logs for this app
#   freesound status    HEAD, pm2 state, local + public probe, cert days
#   freesound token     generate FREESOUND_WRITE_TOKEN into .env
#   freesound keys      which .env keys are set (names only, never values)
#
# Env overrides:
#   FREESOUND_FQDN          default freesound.lab980.com
#   FREESOUND_BRANCH        default main
#   FREESOUND_PORT          default 8074
#   FREESOUND_PROBE_TRIES   default 10 (one second apart)
#
# The app dir is wherever this script's checkout lives (normally
# /var/www/freesound) — derived from the script's own path, so the
# /usr/local/bin symlink resolves back here.
set -euo pipefail

SELF="$(readlink -f "$0")"
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
FQDN="${FREESOUND_FQDN:-freesound.lab980.com}"
BRANCH="${FREESOUND_BRANCH:-main}"
PORT="${FREESOUND_PORT:-8074}"
PROBE_TRIES="${FREESOUND_PROBE_TRIES:-10}"
APP="freesound"

# >>> FILL IN: the `pm2 start` argv that registers this app the FIRST time.
# Every later deploy is a `pm2 restart $APP` of that registration, but on a
# fresh box (or after `pm2 delete`) nothing is registered and restart fails.
# The scaffold cannot know the entrypoint, so it is a placeholder until the
# person finishing the scaffold (SKILL.md step 3) sets it — in the repo, not on
# the droplet, where a tracked-file edit is wiped by the next deploy. Whatever
# it is, it MUST register the process as "$APP": either --name, or an
# ecosystem file whose `name` matches and `--only`. Examples:
#   START_CMD=(ecosystem.config.cjs --only "$APP")
#   START_CMD=(server.js --name "$APP")
#   START_CMD=(npm --name "$APP" -- run start)
# `deploy` refuses a first start while this is still the placeholder. The
# process gets PORT from pm2_clean below and everything else from .env.
START_CMD=(server.mjs --name "$APP")

c_blue=$'\033[1;34m'; c_yellow=$'\033[1;33m'; c_red=$'\033[1;31m'; c_off=$'\033[0m'
log()  { printf '%s==>%s %s\n' "$c_blue" "$c_off" "$*"; }
warn() { printf '%swarn:%s %s\n' "$c_yellow" "$c_off" "$*" >&2; }
die()  { printf '%serror:%s %s\n' "$c_red" "$c_off" "$*" >&2; exit 1; }

usage() {
  cat <<'USAGE'
freesound — operate freesound.lab980.com (pm2 app behind nginx).

Usage:
  freesound deploy [--no-build]   pull, install, build, pm2 start/restart, probe, save
  freesound restart               pm2 restart + probe
  freesound logs [-n N]           tail pm2 logs
  freesound status                HEAD + pm2 + local/public probe + cert
  freesound token [--force]       generate FREESOUND_WRITE_TOKEN into .env
  freesound keys                  which .env keys are set (names only)

Env: FREESOUND_FQDN, FREESOUND_BRANCH (default main), FREESOUND_PORT (default 8074),
     FREESOUND_PROBE_TRIES (default 10).
USAGE
}

# The app runs as root under pm2, and pm2 keeps one daemon, process list and
# dump PER HOME — root's is /root/.pm2. Run as anyone else, or as uid 0 with
# someone else's HOME (`su root` without `-`, `sudo` preserving HOME), and
# every pm2 call here talks to a different daemon: `status` says "not
# registered" while the site is up, and `deploy` starts a second copy.
need_root() {
  [ "$(id -u)" -eq 0 ] || die "$1 must run as root (the app's pm2 daemon is root's)."
  local rhome; rhome="$(getent passwd root | cut -d: -f6)"
  [ -n "${PM2_HOME:-}" ] || [ "${HOME:-}" = "$rhome" ] \
    || die "$1: HOME is '${HOME:-}' but root's home is $rhome — pm2 keys its daemon and dump off HOME, so this would talk to a different pm2. Use \`sudo -i\` or \`su -\` (or set PM2_HOME on purpose)."
}

# ---------------------------------------------------------------------------
# pm2. Every pm2 call goes through pm2_clean, which launches it from an EMPTY
# environment plus the handful of variables pm2 itself needs and PORT. pm2
# copies the environment of the `pm2 start` call into the process, and from
# there into ~/.pm2/dump.pm2 on save — so a plain `pm2 start` (or `pm2
# restart --update-env`, which re-captures the shell on every deploy) gives
# whatever the calling shell holds — a key exported for one command, a
# token — an indefinite on-disk lifetime in the dump. (Until 2026-09-05 a
# root login shell here carried every platform key from /etc/environment;
# it holds none now, and there is no box-level key store.) The daemon
# itself keeps the environment of whichever call first spawned it (visible in
# its /proc/<pid>/environ for as long as it runs; the processes it starts do
# NOT inherit it), which is why jlist and logs go through here as well.
#
# PORT is handed in because provision-site chose it, this script knows it, it
# is not a secret, and an app started from `env -i` would otherwise have no
# port. Everything else the app needs comes from its own `.env` (dotenv, or
# an ecosystem file that reads it) — never from the shell that ran this
# script. A variable the app needs but does not read from `.env` is an app
# change, not an argument to pass here.
# ---------------------------------------------------------------------------
pm2_clean() {
  env -i PATH="$PATH" HOME="$HOME" ${PM2_HOME:+PM2_HOME="$PM2_HOME"} \
    ${TERM:+TERM="$TERM"} LANG=C.UTF-8 PORT="$PORT" pm2 "$@"
}

# `pm2 jlist` is JSON only on a good day: pm2 writes chatter to STDOUT ahead
# of it — `[PM2] Spawning PM2 daemon…` when the daemon was down, `>>>> In-memory
# PM2 is out-of-date` after a pm2 upgrade (node22-bump does one). So the JSON
# is taken from the first line that starts one and parses; anything else is
# reported as unknown (exit 1), never guessed as "not registered" — deploy
# would answer that guess with a second `pm2 start` against a live app.
PM2_JSON='import json, sys
lines = sys.stdin.read().split("\n")
for i, line in enumerate(lines):
    if line[:1] in "[{":
        try:
            procs = json.loads("\n".join(lines[i:]))
        except ValueError:
            continue
        if isinstance(procs, list):
            json.dump(procs, sys.stdout); sys.exit(0)
sys.exit("no parseable JSON in pm2 jlist output")'
pm2_jlist() {   # -> JSON array on stdout; 1 with the reason on stderr
  local jl
  jl="$(pm2_clean jlist 2>/dev/null)" || { echo "pm2 jlist failed" >&2; return 1; }
  printf '%s' "$jl" | python3 -c "$PM2_JSON"
}

# "not registered", "<status>  mode=…", or "unknown (…)" with exit 1.
pm2_state() {
  local js
  js="$(pm2_jlist 2>&1)" || { printf 'unknown (%s)\n' "$js"; return 1; }
  printf '%s' "$js" | python3 -c 'import json, sys
p = [x for x in json.load(sys.stdin) if x.get("name") == sys.argv[1]]
if not p: print("not registered"); raise SystemExit
e = p[0].get("pm2_env", {})
print("%s  mode=%s  restarts=%s  uptime-since=%s" % (
  e.get("status"), e.get("exec_mode"), e.get("restart_time"), e.get("pm_uptime")))' "$APP"
}

# Names of registered processes that are not online (empty = all online);
# exit 1 with the reason when the list cannot be read.
pm2_not_online() {
  local js
  js="$(pm2_jlist 2>&1)" || { printf '%s' "$js"; return 1; }
  printf '%s' "$js" | python3 -c 'import json, sys
print(" ".join(x.get("name", "?") for x in json.load(sys.stdin)
               if x.get("pm2_env", {}).get("status") != "online"))'
}

save_if_online() {
  # pm2 save overwrites the dump with whatever is running right now, so a save
  # while anything is down persists a dump that comes back short on the next
  # reboot. The box rule (lab980 CLAUDE.md) is EVERY app online before a save,
  # not just this one; otherwise say so and leave the previous dump alone.
  local bad
  if ! bad="$(pm2_not_online)"; then
    warn "skipping pm2 save: cannot read the pm2 process list ($bad)"; return 0
  fi
  if [ -n "$bad" ]; then
    warn "not every pm2 process is online ($bad) — skipping pm2 save so the dump keeps its last good state. Run \`pm2 save\` yourself once they are."
    return 0
  fi
  pm2_clean save
}

probe() {
  # Local first, then public: a healthy app behind a broken vhost and a dead
  # app behind a fine vhost look identical from the outside, and telling them
  # apart is most of the diagnosis. Both are printed whatever happens.
  #
  # Pass/fail is the LOCAL port answering HTTP at all — any status code,
  # because an API-only app legitimately 404s on `/` — retried up to
  # PROBE_TRIES times a second apart, since a Node app is often still booting
  # when pm2 first reports it online. The public side only warns: it also
  # depends on DNS and TLS, which may legitimately not be there yet on a
  # first bring-up.
  local lcode="" pcode i
  for ((i = 1; i <= PROBE_TRIES; i++)); do
    lcode="$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 "http://127.0.0.1:$PORT/" || true)"
    [ "$lcode" != "000" ] || lcode=""   # curl's code for "never connected"
    [ -z "$lcode" ] || break
    sleep 1
  done
  pcode="$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 "https://$FQDN/" || true)"
  [ "$pcode" != "000" ] || pcode=""
  printf 'local:     http://127.0.0.1:%s/  ->  HTTP %s\n' "$PORT" "${lcode:-unreachable after $PROBE_TRIES tries}"
  printf 'public:    https://%s/  ->  HTTP %s\n' "$FQDN" "${pcode:-unreachable}"
  [ -n "$lcode" ] || return 1
  case "$pcode" in
    ""|5*) warn "app answers locally but https://$FQDN/ is ${pcode:-unreachable} — look at nginx / DNS / TLS, not the app";;
  esac
}

cmd_deploy() {
  local DO_BUILD=1
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-build) DO_BUILD=0;;
      *) die "unknown deploy option: $1 (see --help)";;
    esac
    shift
  done
  need_root deploy
  command -v pm2 >/dev/null || die "pm2 not found on PATH."
  cd "$ROOT"
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "$ROOT is not a git clone."

  # Decide start-vs-restart BEFORE the sync: a first deploy that cannot start
  # should fail here, not after a hard reset and an npm ci it did not need.
  local state
  state="$(pm2_state)" || die "cannot tell whether $APP is registered — $state. Sort pm2 out first (pm2 ls), then deploy again."
  if [ "$state" = "not registered" ] && [ "${START_CMD[0]:-}" = "<entrypoint>" ]; then
    die "$APP is not registered with pm2 and START_CMD in bin/$APP is still the placeholder — set it to the pm2 start target (see the comment above it), land that, then deploy again."
  fi

  local before after
  before="$(git rev-parse --short HEAD)"
  log "Syncing $ROOT to origin/$BRANCH"
  git fetch --quiet origin "$BRANCH"
  git reset --hard --quiet "origin/$BRANCH"
  after="$(git rev-parse --short HEAD)"
  if [ "$before" = "$after" ]; then log "already current ($after)"
  else log "$before -> $after"; git --no-pager log --oneline "$before..$after"; fi

  # npm ci, not npm install: the lockfile is the deployed dependency set, and
  # a deploy that silently resolves different versions than CI tested is the
  # bug you find at 2am.
  if [ -f package-lock.json ]; then log "npm ci"; npm ci
  elif [ -f package.json ]; then warn "no package-lock.json — falling back to npm install"; npm install; fi

  if [ "$DO_BUILD" -eq 1 ] && [ -f package.json ] && npm run 2>/dev/null | grep -qE '^  build'; then
    log "npm run build"; npm run build
  fi

  case "$state" in
    "not registered")
      log "pm2 start ${START_CMD[*]}  ($APP, first registration)"
      pm2_clean start "${START_CMD[@]}"
      state="$(pm2_state)" || die "pm2 start ran but the process list is unreadable — $state"
      [ "$state" != "not registered" ] \
        || die "pm2 start ran but nothing named $APP is registered — START_CMD must name it (--name $APP, or an ecosystem file whose entry is $APP with --only $APP)."
      ;;
    *)
      log "pm2 restart $APP"
      pm2_clean restart "$APP"
      ;;
  esac
  probe || die "$APP is not answering on 127.0.0.1:$PORT — deploy failed, nothing saved. See: $APP logs"
  save_if_online
  log "deployed: $(git rev-parse --short HEAD)  $(git log -1 --format=%s)"
}

cmd_restart() {
  [ $# -eq 0 ] || die "restart takes no options (see --help)"
  need_root restart
  command -v pm2 >/dev/null || die "pm2 not found on PATH."
  local state
  state="$(pm2_state)" || die "cannot tell whether $APP is registered — $state. Sort pm2 out first (pm2 ls), then retry."
  [ "$state" != "not registered" ] || die "$APP is not registered with pm2 — nothing to restart. First start is: $APP deploy"
  log "pm2 restart $APP"
  pm2_clean restart "$APP"
  probe || die "$APP is not answering on 127.0.0.1:$PORT after restart. See: $APP logs"
}
cmd_logs()    { pm2_clean logs "$APP" "$@"; }

cmd_status() {
  cd "$ROOT"
  printf 'checkout:  %s  %s\n' "$(git rev-parse --short HEAD)" "$(git log -1 --format=%s)"
  printf 'pm2:       %s\n' "$(pm2_state || true)"
  probe || true   # status reports, it does not judge — keep going to the cert
  local pem="/etc/letsencrypt/live/$FQDN/cert.pem"
  if [ -r "$pem" ]; then
    local end days
    end="$(openssl x509 -enddate -noout -in "$pem" | cut -d= -f2)"
    days=$(( ($(date -d "$end" +%s) - $(date +%s)) / 86400 ))
    printf 'cert:      %s days remaining (expires %s)\n' "$days" "$end"
  else
    printf 'cert:      (run as root to read expiry)\n'
  fi
}

# ---------------------------------------------------------------------------
# .env helpers.
#
# Both print key NAMES and never key VALUES. The platform rule about secrets in
# argv (`/proc/<pid>/cmdline` is world-readable, `/proc/<pid>/environ` is 0400)
# applies just as much to a CLI that would echo one into a terminal and from
# there into shell history and somebody's scrollback.
# ---------------------------------------------------------------------------
env_file() { printf '%s/.env' "$ROOT"; }

cmd_keys() {
  local f name value
  f="$(env_file)"
  [ -r "$f" ] || die "no .env at $f — see DEPLOY.md"
  printf 'keys set in %s:\n' "$f"
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|'#'*) continue;; esac
    name="${line%%=*}"; value="${line#*=}"
    [ "$name" != "$line" ] || continue
    if [ -n "$value" ]; then printf '  %-24s set\n' "$name"
    else printf '  %-24s EMPTY\n' "$name"; fi
  done < "$f"
}

cmd_token() {
  local force=0 f tmp
  case "${1:-}" in
    --force) force=1;;
    '') ;;
    *) die "unknown token option: $1 (only --force)";;
  esac
  f="$(env_file)"
  [ -e "$f" ] || { install -m 600 /dev/null "$f"; log "created $f (mode 600)"; }

  if grep -Eq '^FREESOUND_WRITE_TOKEN=.+$' "$f" && [ "$force" -eq 0 ]; then
    die "FREESOUND_WRITE_TOKEN is already set in $f — pass --force to replace it (every browser that saved the old one has to be given the new one)."
  fi

  # Generated and written by one process, so the secret never reaches argv or
  # shell history the way `echo KEY=... >> .env` would.
  tmp="$(mktemp "$f.XXXXXX")"
  chmod 600 "$tmp"
  if ! FS_ENV_SRC="$f" FS_ENV_DST="$tmp" python3 -c '
import os, secrets
src, dst = os.environ["FS_ENV_SRC"], os.environ["FS_ENV_DST"]
token = secrets.token_urlsafe(32)
lines, replaced = [], False
try:
    with open(src) as fh:
        for line in fh:
            if line.startswith("FREESOUND_WRITE_TOKEN="):
                lines.append("FREESOUND_WRITE_TOKEN=%s\n" % token)
                replaced = True
            else:
                lines.append(line)
except FileNotFoundError:
    pass
if not replaced:
    if lines and not lines[-1].endswith("\n"):
        lines.append("\n")
    lines.append("FREESOUND_WRITE_TOKEN=%s\n" % token)
with open(dst, "w") as fh:
    fh.writelines(lines)
'; then
    rm -f "$tmp"
    die "could not write the new .env"
  fi
  mv "$tmp" "$f"
  log "wrote FREESOUND_WRITE_TOKEN to $f"
  cat <<NOTE

The token is in $f. Read it from there — this command deliberately does not
print it, so it stays out of your scrollback and your shell history:

    grep '^FREESOUND_WRITE_TOKEN=' $f

The app polls .env and picks the change up within a few seconds, so no restart
is needed. Paste the token into the site's token prompt to edit boards.
NOTE
}

case "${1:-}" in
  deploy)  shift; cmd_deploy "$@";;
  restart) shift; cmd_restart "$@";;
  logs)    shift; cmd_logs "$@";;
  status)  shift; cmd_status "$@";;
  token)   shift; cmd_token "$@";;
  keys)    shift; cmd_keys "$@";;
  -h|--help|help|"") usage;;
  *) die "unknown command: $1 (see --help)";;
esac
