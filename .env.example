# Copy to .env on the droplet (mode 600) and fill in. Never commit .env.
# provision-site seeds PORT itself — add the rest to that file rather than
# copying over it.

# Local port nginx proxies to. Must match the vhost's proxy_pass.
PORT=8074

# Freesound API key ("Client secret/Api key" from https://freesound.org/apiv2/apply).
# Token auth only — this app never needs OAuth2, because it only reads search
# results and mp3 previews, never original sound downloads.
FREESOUND_API_KEY=

# Shared secret for the routes that mutate boards or spend the API key.
# Generate with `freesound token`. Leave EMPTY to run the site fully open —
# which also means anonymous visitors can spend your Freesound quota.
FREESOUND_WRITE_TOKEN=

# Optional. Cap on the on-disk preview cache, in megabytes (default 512).
# FREESOUND_CACHE_MB=512
