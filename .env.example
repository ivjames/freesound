# Copy to .env on the droplet (mode 600) and fill in. Never commit .env.
# provision-site seeds PORT itself — add the rest to that file rather than
# copying over it.

# Local port nginx proxies to. Must match the vhost's proxy_pass.
PORT=8074

# Freesound API key ("Client secret/Api key" from https://freesound.org/apiv2/apply).
# Token auth only — this app never needs OAuth2, because it only reads search
# results and mp3 previews, never original sound downloads.
FREESOUND_API_KEY=

# Shared secret for the routes that mutate boards or spend the API key.
# Generate with `freesound token`. Leave EMPTY to run the site fully open —
# which also means anonymous visitors can spend your Freesound quota.
FREESOUND_WRITE_TOKEN=

# Anthropic API key, used ONLY to translate clip titles into English for
# display. Freesound is international and you cannot pick a clip off a list you
# cannot read. Optional: leave it empty and titles show exactly as uploaded —
# nothing else changes, and /api/health reports translation as unavailable.
#
# Credits always render Freesound's ORIGINAL title regardless of this setting.
# CC BY means identifying the work as its author named it, so a translation is
# a display label and never an attribution.
ANTHROPIC_API_KEY=

# Optional. Model used for translation (default claude-haiku-4-5). A page of 30
# titles is roughly a quarter of a cent, and each clip is translated once ever —
# the result is cached in data/translations.json and keyed by sound id.
# FREESOUND_TRANSLATE_MODEL=claude-haiku-4-5

# Optional. Cap on the on-disk preview cache, in megabytes (default 512).
# FREESOUND_CACHE_MB=512
